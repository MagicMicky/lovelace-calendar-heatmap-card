{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/update-version.js ${nextRelease.version} && npm run build && gzip -kf dist/calendar-heatmap-card.js"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md",
          "manifest.json",
          "src/constants.js",
          "dist/calendar-heatmap-card.js",
          "dist/calendar-heatmap-card.js.gz",
          "dist/calendar-heatmap-card.js.map"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/calendar-heatmap-card.js",
            "label": "Calendar Heatmap Card (js)"
          },
          {
            "path": "dist/calendar-heatmap-card.js.gz",
            "label": "Calendar Heatmap Card (js.gz)",
            "missing": true
          }
        ]
      }
    ]
  ]
}
